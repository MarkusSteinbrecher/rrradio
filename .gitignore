node_modules
dist
.vite
.cache
.local
internal/
ios/
*.log
.DS_Store
.env
.env.local

# Generated spec-site HTML (served at /spec/ by the dev server)
tools/spec-site/out/

# Generated favicon variants — the whole public/favicons/ dir (per-station
# webp variants + manifest.json) is build output of `npm run favicon-variants`.
# Unused by the web runtime: the app renders the remote `favicon` URL directly
# (CSP img-src allows https:); the `favicons[]` array in stations.json is a
# build-time hint only. Committing ~55k webps bloated .git (~1.5 GB once) and
# broke check-catalog/deploy when #522 shipped a stations.json referencing
# webps it never committed. Regenerated locally by `npm run catalog`.
public/favicons/

# Local project notes — not for upload. The repo is public on GitHub
# Pages; anything in here is internal-only and should never ship.
# (CLAUDE.md is the public operating manual. AGENTS.md is a symlink
# to CLAUDE.md so Codex and Claude read the same file — both tracked.)
session-log.md
session-log*.md
notes/
*.local.md
design_handoff_rrradio/
design_handoff_rrradio_logo/

# iOS landing-page source/reference radio photos (multi-MB scratch art).
# Only radio-photo-reference-clean.png (the cropped shell actually used by the
# page) and radio-button-cap.png are tracked; the raw references stay local.
rrradio-ios/radio-photo-reference.png
rrradio-ios/radio-photo-reference2.png
rrradio-ios/radio-photo-reference3*.png

# ICY parser corpus — captured StreamTitles + Gemma labels. May contain
# ad copy, station IDs, free-form text from third-party broadcasters.
# Stays local; the improved parser ships in src/icyMetadata.ts.
data/icy-samples.jsonl
data/icy-labels.jsonl

# Metadata-API discovery output — captured XHR bodies from broadcaster
# web players. Build-time only; the discovered URLs ship via fetchers
# in src/builtins.ts but the raw captures stay local.
data/metadata-discovery/

# Local agent state — Claude-specific instructions / settings that
# have no place in a public repo. Skills are an exception: project-
# scoped agent skills (`.claude/skills/<name>/SKILL.md`) ship with
# the repo so anyone cloning gets the same automation surface.
# (We exclude contents rather than the dir itself so the !exception
# below actually re-includes — git can't un-ignore a path whose
# parent dir is ignored.)
.claude/*
!.claude/skills/

# Playwright e2e (audit #63)
playwright-report/
test-results/
.playwright/
# Playwright MCP scratch (console/page dumps)
.playwright-mcp/

# Catalog quality loop scratch (ADR 002): a local health-data checkout and decide output
health-data/
actions.json
