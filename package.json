{
  "name": "internet-radio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node tools/build-catalog.mjs && node tools/build-discovery.mjs && node tools/build-highlights.mjs && node tools/extract-manual-source.mjs && node tools/dedupe-raw.mjs && node tools/build-sources.mjs && vite",
    "fetch-rb-raw": "node tools/fetch-rb-raw.mjs",
    "dedupe-raw": "node tools/dedupe-raw.mjs",
    "extract-manual-source": "node tools/extract-manual-source.mjs",
    "analyze-rb": "node tools/analyze-rb.mjs",
    "analyze-rb-all": "node tools/analyze-rb-all.mjs",
    "build": "tsc && vite build && node tools/build-station-pages.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "catalog": "node tools/build-catalog.mjs && node tools/build-discovery.mjs && node tools/build-highlights.mjs && node tools/build-favicon-variants.mjs",
    "highlights": "node tools/build-highlights.mjs",
    "check-highlights": "node tools/check-highlights.mjs",
    "spec-site": "python3 tools/spec-site/generate.py",
    "favicon-variants": "node tools/build-favicon-variants.mjs",
    "catalog:ios-local": "node tools/build-ios-local-catalog.mjs",
    "station-capabilities": "node tools/build-station-capabilities.mjs",
    "station-profiles": "node tools/build-station-profiles.mjs",
    "catalog:fts": "node tools/build-catalog-fts.mjs",
    "probe": "node tools/probe-station.mjs",
    "probe:bytes": "python3 tools/audio-byte-probe.py",
    "probe:browser": "node tools/browser-audio-probe.mjs",
    "candidates": "node tools/candidates.mjs",
    "validate-catalog": "node tools/health-probe.mjs --strict",
    "check-drift": "node tools/check-drift.mjs",
    "health": "node tools/health-probe.mjs",
    "health-import": "node tools/health-import.mjs",
    "check-duplicates": "node tools/check-duplicates.mjs",
    "detect-families": "node tools/detect-families.mjs",
    "check-catalog": "node tools/check-catalog.mjs",
    "check-homepages": "node tools/check-homepages.mjs",
    "build-sources": "node tools/build-sources.mjs",
    "auto-curate": "node tools/auto-curate.mjs",
    "import-playable": "node tools/import-playable-candidates.mjs",
    "build-rb-index": "node tools/build-rb-index.mjs",
    "improve-rb": "node tools/improve-rb.mjs",
    "logo-status": "node tools/logo-status.mjs",
    "scout-logos": "node tools/browser-logo-scout.mjs",
    "probe-logos": "node tools/probe-logo-sizes.mjs",
    "clear-dead-favicons": "node tools/clear-dead-favicons.mjs",
    "rasterise-remote-svgs": "node tools/rasterise-remote-svgs.mjs",
    "pngquant-stations": "node tools/pngquant-stations.mjs",
    "scrape-logos": "node tools/scrape-logos.mjs",
    "scrape-channel-art": "node tools/scrape-channel-art.mjs",
    "apply-logos": "node tools/apply-logos.mjs",
    "harvest-logos": "node tools/harvest-broadcaster-logos.mjs",
    "wiki-logos": "node tools/wiki-logos.mjs",
    "migrate-nonfree-logos": "node tools/migrate-nonfree-logos.mjs",
    "http-upgrade": "node tools/http-upgrade.mjs",
    "curation-db:init": "node tools/curation-db.mjs init",
    "curation-db:ingest": "node tools/curation-db.mjs ingest",
    "curation-db:summary": "node tools/curation-db.mjs summary",
    "curation-db:reset": "node tools/curation-db.mjs reset",
    "curation-db:dedupe": "node tools/curation-db.mjs dedupe",
    "curation-db:dedupe-report": "node tools/curation-db.mjs dedupe-report",
    "analyze": "node tools/health-probe.mjs",
    "backlog": "node tools/backlog.mjs",
    "triage-reports": "node tools/triage-reports.mjs",
    "propose-station-fix": "node tools/propose-station-fix.mjs",
    "import-ard": "node tools/import-ard.mjs",
    "backfill-geo": "node tools/backfill-geo.mjs",
    "wire-metadata": "node tools/wire-metadata.mjs",
    "sample-icy": "node tools/sample-icy.mjs",
    "gemma-label-icy": "node tools/gemma-label-icy.mjs",
    "evaluate-icy-parser": "node tools/evaluate-icy-parser.mjs",
    "discover-metadata": "node tools/discover-metadata-api.mjs"
  },
  "dependencies": {
    "hls.js": "^1.5.17",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/leaflet": "^1.9.21",
    "happy-dom": "^20.11.0",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
